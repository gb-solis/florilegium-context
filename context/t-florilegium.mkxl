%D \module
%D   [     file=t-florilegium,
%D      version=2.0.1,
%D        title=\CONTEXT\ User Module,
%D     subtitle=florilegium: a procedurally generated floral page margin,
%D       author=Kevin Raymond,
%D         date=2026-11-03,
%D    copyright=Kevin Raymond,
%D      license=MIT]
